+def token_jaccard(old_text: str, new_text: str) -> float:
+    """Jaccard over unique, case-folded Unicode word tokens; empty/empty = 1."""
+    old_tokens = set(re.findall(r"\w+", old_text.casefold()))
+    new_tokens = set(re.findall(r"\w+", new_text.casefold()))
+    union = old_tokens | new_tokens
+    return len(old_tokens & new_tokens) / len(union) if union else 1.0
 
 
